<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- The game's TV screen. -->
    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <!-- First run, or "Change PC address": where is the game? -->
    <LinearLayout
        android:id="@+id/setup"
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="@color/text"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/setup_body"
            android:textColor="@color/muted"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/field"
            android:hint="@string/setup_hint"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:singleLine="true"
            android:textColor="#FF1C1712"
            android:textColorHint="#FF8A7B66"
            android:textSize="22sp" />

        <Button
            android:id="@+id/connect"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/button"
            android:text="@string/setup_connect"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- The PC didn't answer: keep retrying, let the player fix the address. -->
    <LinearLayout
        android:id="@+id/offline"
        android:layout_width="720dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/offline_title"
            android:textColor="@color/text"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/offline_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/muted"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/retry"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginRight="16dp"
                android:layout_weight="1"
                android:background="@drawable/button"
                android:text="@string/retry"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="20sp" />

            <Button
                android:id="@+id/change"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:background="@drawable/button"
                android:text="@string/change_address"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
