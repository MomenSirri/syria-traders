<?xml version="1.0" encoding="utf-8"?>
<!-- Big, clearly focused buttons for the TV remote. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/accent" /><corners android:radius="12dp" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/panel" /><corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/muted" /></shape>
    </item>
</selector>
